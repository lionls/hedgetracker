# Contact e-mail sent to the SEC as the edgartools identity.
# The SEC requires a real, monitored address in the User-Agent of every request.
# Required in production; the pipeline falls back to a test address if unset.
SEC_IDENTITY_EMAIL=mark@gmail.com

# Root of the local Parquet data lake. Written as
# {base_dir}/13f_holdings/year={YYYY}/quarter={Q}/{CIK}.parquet
HEDGETRACKER_BASE_DIR=data/lake

# Prefect API the worker and the one-shot CLI talk to. Uncomment both to run the
# flows on another instance (or Prefect Cloud) instead of the compose server —
# see the README for the worker command that goes with them.
#PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account>/workspaces/<workspace>
#PREFECT_API_KEY=pnu_...

# Market explorer (docker compose up -d --build explorer): the published host
# port, DuckDB's limits, and the proxy to read Hugging Face through if the
# server has no direct egress.
#EXPLORER_PORT=8080
#EXPLORER_MEMORY=2GB
#EXPLORER_THREADS=4
#EXPLORER_HTTPS_PROXY=http://user:password@proxy.example.com:3128
#EXPLORER_NO_PROXY=
